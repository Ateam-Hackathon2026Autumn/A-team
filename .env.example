MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=hackathon
MYSQL_USER=hackathon
MYSQL_PASSWORD=hackathon_password

DJANGO_SECRET_KEY=hackathon_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend

# バケット設定が両方空ならローカルの media/ に保存します。
# 通常用のバケットを指定すると、検証用より優先されます。
AWS_STORAGE_BUCKET_NAME=

# 検証用S3を使う場合は次の行のコメントを外します。
AWS_TEST_UPLOADS_BUCKET_NAME=a-team-test-uploads-048588986880-ap-northeast-1
# AWS_ACCESS_KEY_ID、AWS_SECRET_ACCESS_KEY、AWS_SESSION_TOKEN は各自のAWSプロファイルからターミナル経由で渡します。
