# ローカル開発用の例。cp .env.example .env して使う（.env はコミットしない）
# 空のままの項目は config/settings.py の既定値（ローカル用）になる

# --- ローカルの MySQL コンテナ（AWS では使わない。RDS は DB_* で渡す）---
MYSQL_ROOT_PASSWORD=root_password
MYSQL_DATABASE=hackathon
MYSQL_USER=hackathon
MYSQL_PASSWORD=hackathon_password

# --- Django ---
# 本番は DJANGO_DEBUG=false。そのとき SECRET_KEY が開発用・32文字未満だと起動しない
DJANGO_SECRET_KEY=hackathon_secret_key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
# フロントの URL（カンマ区切り）。空ならローカル（http://localhost:5173）
DJANGO_CSRF_TRUSTED_ORIGINS=
# 本番（HTTPS）は true
DJANGO_COOKIE_SECURE=
# ログの細かさ（既定 INFO）
DJANGO_LOG_LEVEL=
# Django 標準の管理画面（/api/django-admin/）を開くか。空なら DJANGO_DEBUG と同じ（本番は既定でオフ）
DJANGO_ADMIN_ENABLED=
# メール本文のリンクに使うフロントの URL。空なら http://localhost:5173
FRONTEND_BASE_URL=

# --- メール（空ならコンソールに出すだけで送らない）---
DJANGO_EMAIL_BACKEND=
DJANGO_DEFAULT_FROM_EMAIL=

# --- 画像 ---
# 空欄なら backend/media/ に保存する。S3 で試す人だけ、自分の .env にバケット名を設定する。
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=
# S3への書き込みには、AWS_ACCESS_KEY_ID と AWS_SECRET_ACCESS_KEY をターミナルから渡す。一時認証情報では AWS_SESSION_TOKEN も渡す。
# 公開画像を配信する URL の頭（本番は CloudFront。例: https://d123.cloudfront.net）。空なら保存先の URL
DJANGO_PUBLIC_IMAGE_BASE_URL=
# S3 を使わないときの画像の URL。空なら http://localhost:8000/media/
DJANGO_MEDIA_URL=

# --- Stripe（空なら決済・返金は使えない）---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- 規約の版（空なら config/settings.py の値）---
TERMS_VERSION=
PRIVACY_POLICY_VERSION=
