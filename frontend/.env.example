# コピー先: .env.development.local（設定変更後は Vite を再起動）
VITE_USE_MOCK=false
# 同一オリジン / Vite proxy を利用する場合は空欄
VITE_API_URL=
# 稼働中バックエンドの TERMS_VERSION / PRIVACY_POLICY_VERSION に合わせる
# バックエンドの既定値は両方 2026-10-01。環境で上書きされていないか確認すること。
VITE_TERMS_VERSION=
VITE_PRIVACY_POLICY_VERSION=
# 公開済みの正式な規約本文の URL。未設定時は登録を送信しない。
VITE_TERMS_URL=
VITE_PRIVACY_POLICY_URL=
